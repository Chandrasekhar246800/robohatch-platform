# Vercel Environment Variables Example
# Add these in your Vercel project settings under Environment Variables

# Public API base URL for browser-side calls.
# IMPORTANT: Set this to your public site origin so cookies are first-party.
# Example: https://robohatch.in
# 
# ✅ CORRECT:
#   NEXT_PUBLIC_API_URL=https://robohatch.in
#
# Railway backend used only by Next.js rewrites:
#   API_BACKEND_URL=https://robohatchapi-production.up.railway.app
#
# ❌ WRONG: point this at the Railway host
#   NEXT_PUBLIC_API_URL=https://your-railway-api.up.railway.app

NEXT_PUBLIC_API_URL=https://yourdomain.com
API_BACKEND_URL=https://your-railway-api.up.railway.app

# Example with actual deployment:
# NEXT_PUBLIC_API_URL=https://robohatch.in
# API_BACKEND_URL=https://robohatchapi-production.up.railway.app

# Note: NEXT_PUBLIC_ prefix makes the variable available in the browser
# Never add sensitive keys with the NEXT_PUBLIC_ prefix!
