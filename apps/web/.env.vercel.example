# Vercel Environment Variables Example
# Add these in your Vercel project settings under Environment Variables

# Browser traffic must stay same-origin and hit /api on the public site.
# The Next.js route handler proxies /api to the Railway backend server-side.

# Optional: used only for dev/server fallbacks and should never point at Railway.
NEXT_PUBLIC_API_URL=https://robohatch.in

# Required: private server-side backend target for the App Router proxy.
API_BACKEND_URL=https://your-railway-api.up.railway.app

# Example with actual deployment:
# NEXT_PUBLIC_API_URL=https://robohatch.in
# API_BACKEND_URL=https://robohatchapi-production.up.railway.app
