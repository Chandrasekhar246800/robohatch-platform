# Deterministic E2E environment for local and CI parity
# NOTE: these are test credentials and URLs; CI should override secrets when required

# Base URLs
# Leave PLAYWRIGHT_BASE_URL empty to allow Playwright to start the local web server.
PLAYWRIGHT_BASE_URL=http://localhost:3004
E2E_API_BASE_URL=http://localhost:3102

# Customer credentials
E2E_TEST_USER_EMAIL=e2e.customer@robohatch.local
E2E_TEST_USER_PASSWORD=E2E_test_pass_2026!

# Admin credentials
E2E_ADMIN_EMAIL=e2e.admin@robohatch.local
E2E_ADMIN_PASSWORD=E2E_admin_pass_2026!

# Payment/test secrets (CI can override with real test keys)
E2E_RAZORPAY_KEY_SECRET=rzp_test_key_abc123
E2E_RAZORPAY_WEBHOOK_SECRET=rzp_wh_secret_abc123

# Feature toggles for deterministic runs
E2E_ALLOW_SIGNUP=false
E2E_PAYMENT_MODE=mock
E2E_STABLE_PRODUCT_ID=9d39b839-441d-4e8a-b18e-8e49518ee839
