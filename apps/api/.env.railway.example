# Railway Environment Variables Example
# Copy these to your Railway project's Variables section

# Server
NODE_ENV=production
PORT=5000

# Database (from Railway MySQL plugin)
# Railway will automatically provide this when you add MySQL
DATABASE_URL=mysql://user:password@host:port/database

# JWT - IMPORTANT: Generate a strong secret!
# Use: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AWS S3 (for image uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-north-1
AWS_S3_BUCKET=your-bucket-name

# CORS - CRITICAL FOR FRONTEND TO WORK
# Add your Vercel frontend URL here
# Format: comma-separated list of allowed origins (no spaces!)
# 
# Option 1: Specific domain (most secure)
#   ALLOWED_ORIGINS=https://your-app.vercel.app
#
# Option 2: Multiple specific domains
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://custom-domain.com
#
# Option 3: Wildcard for all Vercel preview deployments (recommended for development)
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://*.vercel.app
#
# Option 4: Allow all (NOT RECOMMENDED for production)
#   ALLOWED_ORIGINS=*
#
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app,https://*.vercel.app

# Rate Limiting (adjust based on your needs)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10
