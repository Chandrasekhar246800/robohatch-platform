{
  "name": "@robohatch/api",
  "version": "0.0.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "ts-node-dev src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "start:ci": "node dist/index.js",
    "postinstall": "prisma generate",
    "deploy": "prisma db push && npm run seed",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "seed": "tsx prisma/seed.ts",
    "seed:e2e": "tsx prisma/seed-e2e-product.ts",
    "update-categories": "tsx prisma/update-categories.ts",
    "test:auth-concurrency": "npx tsx --test tests/auth-concurrency.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@prisma/client": "^5.22.0",
    "@prisma/driver-adapter-utils": "^7.3.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^7.100.0",
    "@types/bcrypt": "^5.0.2",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "file-type": "^21.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.16.2",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "razorpay": "^2.9.6",
    "react-hot-toast": "^2.6.0",
    "stl-parser": "^0.11.1",
    "zod": "^4.3.6"
