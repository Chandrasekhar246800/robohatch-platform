# Environment
NODE_ENV=production
PORT=5000

# Database - Replace with your production database
DATABASE_URL="mysql://prod_user:prod_password@production-db-host:3306/prod_database?sslaccept=strict&connection_limit=15&pool_timeout=10"

# JWT Authentication - MUST BE CHANGED
JWT_SECRET="CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MIN-64-CHARS-USE-openssl-rand-hex-32"
JWT_EXPIRES_IN="7d"

# AWS S3 Configuration - Replace with production credentials
AWS_ACCESS_KEY_ID=your-production-aws-access-key
AWS_SECRET_ACCESS_KEY=your-production-aws-secret-key
AWS_REGION=eu-north-1
AWS_S3_BUCKET=your-production-s3-bucket

# CORS Configuration - Replace with your production domain
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
COOKIE_DOMAIN=yourdomain.com

# Rate Limiting - Production values
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit this file with real credentials
# 2. Use environment variables from your hosting provider
# 3. Rotate JWT_SECRET regularly
# 4. Use strong database passwords
# 5. Restrict AWS IAM permissions to minimum required
# 6. Enable AWS MFA for production access
# 7. Use SSL/TLS for all connections
# 8. Enable database encryption at rest
# 9. Set up database backups
# 10. Monitor for unusual activity
